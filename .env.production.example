# ==============================================================================
# OX-DIGITAL Education — Production Environment Configuration Template
# ==============================================================================
# STRICT ISOLATION MANDATE:
# This application is fully independent. It MUST NOT connect to the legacy
# database, old volumes, old Redis instances, or old networks.
#
# USAGE INSTRUCTIONS:
# 1. Copy this file to `.env.production` on the production host.
# 2. Secure file permissions: chmod 600 .env.production
# 3. Supply strong, unique production secrets (DO NOT reuse old credentials).
# 4. NEVER commit `.env.production` or real passwords to version control.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Public Ingress & Host Port Binding
# During staging/coexistence with legacy services on ports 80/443, use 8080 and 8443.
# When cutting over to live production as primary host gateway, set to 80 and 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# Client & CORS Configuration
CLIENT_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com
TRUST_PROXY=1

# ==============================================================================
# Database Configuration (PostgreSQL Dedicated Instance)
# ==============================================================================
# For docker-compose.production.yml, the internal service hostname is 'postgres'.
# The dedicated isolated database name is 'ox_digital_education'.
# DO NOT set the database name to 'math_platform' or connect to legacy volumes.
DATABASE_URL=postgresql://ox_admin:[DB_PASSWORD]@postgres:5432/ox_digital_education?schema=public
DIRECT_URL=postgresql://ox_admin:[DB_PASSWORD]@postgres:5432/ox_digital_education?schema=public

# Docker Internal PostgreSQL Credentials (Required by docker-compose.production.yml)
POSTGRES_USER=ox_admin
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=ox_digital_education

# ==============================================================================
# Initial Administrator Account Provisioning
# ==============================================================================
# Required ONLY when executing explicit bootstrap (node scripts/ensure_admin.mjs --bootstrap).
# Minimum 8 characters; 24+ characters randomly generated recommended.
# Default passwords are strictly prohibited.
ADMIN_EMAIL=admin@edu.com
INITIAL_ADMIN_PASSWORD=replace_with_strong_initial_admin_password_min_8_chars

# ==============================================================================
# Redis Cache & Session Store
# ==============================================================================
# Internal service hostname 'redis' in ox-digital-network
REDIS_URL=redis://redis:6379

# ==============================================================================
# Cryptographic Secrets (Generate via `openssl rand -base64 64`)
# ==============================================================================
JWT_SECRET=replace_with_strong_64_byte_random_string
REFRESH_TOKEN_SECRET=replace_with_strong_64_byte_random_string
JWT_REFRESH_SECRET=replace_with_strong_64_byte_random_string

# ==============================================================================
# Outbound Email Service (Used by auth-service)
# ==============================================================================
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@your-domain.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="OX-DIGITAL Education" <noreply@your-domain.com>
SENDGRID_API_KEY=replace_with_sendgrid_api_key_if_used
SENDGRID_FROM=noreply@your-domain.com

# ==============================================================================
# AI Service (OpenRouter & LLM Configuration)
# ==============================================================================
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=mistralai/mistral-small-24b-instruct-2501
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_EMERGENCY_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=replace_with_gemini_api_key_if_used

# ==============================================================================
# Cloud Storage & Video Processing
# ==============================================================================
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

CLOUDFLARE_R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=ox-digital-videos-prod

# ==============================================================================
# Payment Gateways (Optional)
# ==============================================================================
PAYMOB_API_KEY=replace_with_paymob_api_key
FAWRY_MERCHANT_CODE=replace_with_fawry_merchant_code
FAWRY_SECURITY_KEY=replace_with_fawry_security_key
STRIPE_SECRET_KEY=replace_with_stripe_secret_key

# ==============================================================================
# Monitoring & Error Tracking
# ==============================================================================
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production

# ==============================================================================
# Automated Database Backup Service (Dedicated Local & Cloud Storage)
# ==============================================================================
GDRIVE_CLIENT_ID=replace_with_gdrive_client_id
GDRIVE_CLIENT_SECRET=replace_with_gdrive_client_secret
GDRIVE_REFRESH_TOKEN=replace_with_gdrive_refresh_token
GDRIVE_FOLDER_PATH=OX-Digital-Backups/PostgreSQL
LOCAL_RETENTION_DAYS=7
REMOTE_RETENTION_COUNT=30

# ==============================================================================
# Frontend Build-Time Variables
# ==============================================================================
VITE_AUTH_API_URL=/api/auth
VITE_USER_API_URL=/api/users
VITE_AI_API_URL=/api/ai
VITE_COURSE_API_URL=/api/courses
VITE_ANALYTICS_API_URL=/api/analytics
