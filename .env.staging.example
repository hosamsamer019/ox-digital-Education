# ==============================================================================
# OX-DIGITAL Education — Staging Environment Configuration Template
# ==============================================================================
# STRICT ISOLATION MANDATE:
# This staging environment is completely independent. It MUST NOT connect to
# production databases, production Redis, production volumes, production R2
# storage, or production networks.
#
# USAGE INSTRUCTIONS:
# 1. Copy this file to `.env.staging` on the staging host.
# 2. Secure file permissions: chmod 600 .env.staging
# 3. Supply isolated staging secrets. DO NOT use production credentials!
# 4. NEVER commit `.env.staging` or real credentials to version control.
# ==============================================================================

# Node Environment
NODE_ENV=staging

# Ingress & Dedicated Staging Host Ports (Verified free on host)
HTTP_PORT=8090
HTTPS_PORT=8444

# Client & CORS Configuration (Point strictly to staging origin)
CLIENT_URL=http://localhost:8090
ALLOWED_ORIGINS=http://localhost:8090
TRUST_PROXY=1

# ==============================================================================
# Staging Database Configuration (Dedicated Isolated Staging Container)
# ==============================================================================
# Service hostname 'postgres' inside ox-digital-staging-network.
# Database catalog is 'ox_digital_staging'.
# MUST NOT reference 'ox_digital_education' or production named volumes.
POSTGRES_USER=ox_staging_admin
POSTGRES_PASSWORD=replace_with_staging_database_password_min_16_chars
POSTGRES_DB=ox_digital_staging
DATABASE_URL=postgresql://ox_staging_admin:replace_with_staging_database_password_min_16_chars@postgres:5432/ox_digital_staging?schema=public
DIRECT_URL=postgresql://ox_staging_admin:replace_with_staging_database_password_min_16_chars@postgres:5432/ox_digital_staging?schema=public

# Staging Administrator Provisioning (Used ONLY for initial bootstrap)
ADMIN_EMAIL=staging-admin@ox-digital.local
INITIAL_ADMIN_PASSWORD=replace_with_staging_admin_password_min_12_chars

# ==============================================================================
# Staging Redis Cache & Session Store
# ==============================================================================
# Service hostname 'redis' inside ox-digital-staging-network
REDIS_URL=redis://redis:6379

# ==============================================================================
# Staging Cryptographic Signing Keys
# ==============================================================================
# Generate distinct random secrets for staging. DO NOT reuse production keys!
JWT_SECRET=replace_with_staging_64_byte_random_string_do_not_use_prod_key
REFRESH_TOKEN_SECRET=replace_with_staging_64_byte_refresh_secret
JWT_REFRESH_SECRET=replace_with_staging_64_byte_refresh_secret

# ==============================================================================
# External Integrations (DISABLED FOR STAGING ISOLATION)
# ==============================================================================
# Outbound email disabled or redirected to local test sink
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM=

# AI & LLM APIs (Disabled or test keys only)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Cloudflare R2 Cloud Storage (MUST NOT connect to production bucket)
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=ox-digital-videos-staging-disabled

# Payment Gateways (MUST NOT connect to live merchant accounts)
PAYMOB_API_KEY=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
STRIPE_SECRET_KEY=

# Error Monitoring (Telemetry disabled in local staging)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
